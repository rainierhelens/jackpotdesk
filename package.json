{
  "name": "jackpotdesk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bake:wa": "node scripts/bake-wa-draws.mjs",
    "bake:map": "node scripts/bake-jackpot-wins.mjs",
    "bake:claimed": "node scripts/bake-wa-claimed-prizes.mjs",
    "bake:market": "node scripts/bake-market.mjs",
    "bake:popularity": "node scripts/popularity-scrape.mjs && node scripts/wa-popularity-scrape.mjs",
    "fit:popularity": "node scripts/fit-popularity.mjs",
    "deploy:wa": "npx wrangler deploy",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "digest": "tsx scripts/draw-digest.ts",
    "digest:dry": "tsx scripts/draw-digest.ts --dry",
    "recap": "tsx scripts/draw-recap.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
